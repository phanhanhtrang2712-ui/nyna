rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global catch-all deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Public read collections
    match /news/{articleId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /jobs/{jobId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /distributors/{distId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isSignedIn();
    }
  }
}
